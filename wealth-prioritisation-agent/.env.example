# Copy this file to .env and fill in your own key. Never commit the real .env file.
GEMINI_API_KEY=AQ.Ab8RN6I3aLsKAT69H6UUqn8dLE2ClHILh5BzTnbGnRT01CdeYA

# Which Gemini model to use for the reasoning agents (attribution, recommendation, etc.)
# gemini-2.5-flash was retired for new users after this project was scaffolded — the API
# itself now points new callers at gemini-3.6-flash, so that's the default below. If you
# hit a 404 "model no longer available" error again in future, run:
#   python3 -c "from google import genai; import os; c=genai.Client(api_key=os.environ['GEMINI_API_KEY']); [print(m.name) for m in c.models.list()]"
# to list the models your key can actually see, and update this value to match.
GEMINI_MODEL=gemini-3.6-flash

# --- API security (src/api.py) ---
# A secret ONLY your dashboard needs to know to call this API. This is
# separate from GEMINI_API_KEY on purpose: your dashboard/friend never needs
# your Gemini key, only this one. Generate a real value with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
API_SHARED_SECRET=Ffz_ylpAKaTyKZA4CtGee-ZeqTK_jxVgClzOUjYmoLc

# Comma-separated list of origins allowed to call this API from a browser.
# Leave empty to block all browser origins (server-to-server calls with the
# X-API-Key header still work either way — this only affects CORS/browser
# fetch calls). Add your dashboard's dev server URL here, e.g.:
# ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
ALLOWED_ORIGINS=http://localhost:3000
